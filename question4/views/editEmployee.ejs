<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Employee - ERP System</title>
    <script>
        function calculateSalary() {
            const basic = parseFloat(document.getElementById('basicSalary').value) || 0;
            const hra = parseFloat(document.getElementById('hra').value) || 0;
            const da = parseFloat(document.getElementById('da').value) || 0;
            const deductions = parseFloat(document.getElementById('deductions').value) || 0;

            const gross = basic + hra + da;
            const net = gross - deductions;

            document.getElementById('grossDisplay').innerText = gross.toFixed(2);
            document.getElementById('netDisplay').innerText = net.toFixed(2);
        }
    </script>
</head>
<body onload="calculateSalary()">
    <h1>Edit Employee Details (<%= employee.empid %>)</h1>
    <p><a href="/dashboard">Back to Employees List</a></p>

    <% if (error) { %>
        <p style="color: red;"><strong>Error:</strong> <%= error %></p>
    <% } %>

    <form action="/employees/edit/<%= employee._id %>" method="post">
        <h3>1. Employee Information</h3>
        
        <label>Employee ID : </label>
        <input type="text" value="<%= employee.empid %>" disabled style="background-color: #eee;">
        <br><br>

        <label for="name">Full Name : </label>
        <input type="text" name="name" id="name" value="<%= employee.name %>" required>
        <br><br>

        <label for="email">Email Address : </label>
        <input type="email" name="email" id="email" value="<%= employee.email %>" required>
        <br><br>

        <label for="phone">Phone Number : </label>
        <input type="text" name="phone" id="phone" value="<%= employee.phone %>">
        <br><br>

        <label for="department">Department : </label>
        <select name="department" id="department" required>
            <option value="IT & Software" <%= employee.department === 'IT & Software' ? 'selected' : '' %>>IT & Software</option>
            <option value="HR & Admin" <%= employee.department === 'HR & Admin' ? 'selected' : '' %>>HR & Admin</option>
            <option value="Finance & Accounts" <%= employee.department === 'Finance & Accounts' ? 'selected' : '' %>>Finance & Accounts</option>
            <option value="Sales & Marketing" <%= employee.department === 'Sales & Marketing' ? 'selected' : '' %>>Sales & Marketing</option>
            <option value="Operations" <%= employee.department === 'Operations' ? 'selected' : '' %>>Operations</option>
        </select>
        <br><br>

        <label for="designation">Designation : </label>
        <input type="text" name="designation" id="designation" value="<%= employee.designation %>" required>
        <br><br>

        <hr>

        <h3>2. Salary Details (in ₹)</h3>
        <label for="basicSalary">Basic Salary : </label>
        <input type="number" step="0.01" name="basicSalary" id="basicSalary" value="<%= employee.basicSalary %>" oninput="calculateSalary()" required>
        <br><br>

        <label for="hra">HRA (House Rent Allowance) : </label>
        <input type="number" step="0.01" name="hra" id="hra" value="<%= employee.hra %>" oninput="calculateSalary()" required>
        <br><br>

        <label for="da">DA (Dearness Allowance) : </label>
        <input type="number" step="0.01" name="da" id="da" value="<%= employee.da %>" oninput="calculateSalary()" required>
        <br><br>

        <label for="deductions">Deductions (PF / Tax) : </label>
        <input type="number" step="0.01" name="deductions" id="deductions" value="<%= employee.deductions %>" oninput="calculateSalary()" required>
        <br><br>

        <table border="1" cellpadding="6" cellspacing="0">
            <tr>
                <th>Gross Salary</th>
                <th>Net Salary</th>
            </tr>
            <tr>
                <td>₹<span id="grossDisplay"><%= employee.grossSalary.toFixed(2) %></span></td>
                <td><strong>₹<span id="netDisplay"><%= employee.netSalary.toFixed(2) %></span></strong></td>
            </tr>
        </table>

        <br><br>

        <input type="submit" value="Update Employee Details">
        <a href="/dashboard"><input type="button" value="Cancel"></a>
    </form>
</body>
</html>
